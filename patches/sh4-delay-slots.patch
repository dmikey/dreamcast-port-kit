+    def _inline_branch_table_targets(self):
+        """Recognize bounded runs of inline BRA/NOP entries after BRAF Rn.
+
+        The selector can be built in a register across earlier calls. Require
+        two real branch entries, valid delay slots and at most 32 table slots;
+        discovering labels does not change the selector or execute a shortcut.
+        """
+        targets = set()
+        for off in range(0, self.size - 8, 2):
+            if self.read_u16(off) & 0xF0FF != 0x0023 or self.read_u16(off + 2) != 0x0009:
+                continue
+            start = off + 4
+            entries = []
+            branches = 0
+            for i in range(32):
+                at = start + i*4
+                if at + 4 > self.size:
+                    break
+                op, slot = self.read_u16(at), self.read_u16(at + 2)
+                if slot != 0x0009 or not (op == 0x0009 or op & 0xF000 == 0xA000):
+                    break
+                branches += op & 0xF000 == 0xA000
+                entries.append(self.offset_to_addr(at))
+            if branches >= 2:
+                targets.update(entries)
+        return targets
